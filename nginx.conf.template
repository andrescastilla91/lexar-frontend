# Template procesado con envsubst en el entrypoint.
# Vars: ${PORT} ${BACKEND_HOST} ${NAMESERVER}
# Resolución lazy del backend (variable + resolver) para que nginx arranque
# aunque el backend aún no resuelva (Docker y Railway private networking).

server {
    listen       ${PORT};
    listen  [::]:${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # --- Seguridad ---
    server_tokens off;
    # BUG-13: los `add_header` de seguridad NO viven acá — nginx solo los
    # heredaría en los `location` que no definan ningún `add_header` propio,
    # y los tres de abajo sí definen el suyo (Cache-Control). Se incluyen
    # explícitos en cada uno vía security-headers.conf (única fuente real).

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 25m;   # subida de documentos legales

    # --- API: proxy al backend interno (nunca expuesto públicamente) ---
    # ^~ evita que el bloque regex de cache de assets (más abajo) le robe
    # rutas como /api/docs/swagger-ui.css — sin esto, nginx prioriza
    # cualquier location regex sobre un prefix location, sin importar
    # cuál es más específico.
    location ^~ /api/ {
        # security-headers.conf ahora vive en /etc/nginx/templates/ (para
        # que envsubst resuelva ${CSP_CONNECT_SRC_EXTRA}) — el entrypoint
        # oficial de nginx lo procesa y lo deja en /etc/nginx/conf.d/.
        include /etc/nginx/conf.d/security-headers.conf;
        # BUG-13: sin esto, los headers de seguridad de helmet (backend)
        # pasaban tal cual y se sumaban a los de nginx de arriba —
        # duplicados, dos en conflicto real (X-Frame-Options,
        # Referrer-Policy). nginx queda como única fuente para /api/* también.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Strict-Transport-Security;

        resolver ${NAMESERVER} valid=30s;
        set $upstream http://${BACKEND_HOST};
        proxy_pass $upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # --- Assets con hash: cache inmutable ---
    location ~* \.(?:js|css|woff2?|svg|png|jpg|jpeg|webp|ico)$ {
        # security-headers.conf ahora vive en /etc/nginx/templates/ (para
        # que envsubst resuelva ${CSP_CONNECT_SRC_EXTRA}) — el entrypoint
        # oficial de nginx lo procesa y lo deja en /etc/nginx/conf.d/.
        include /etc/nginx/conf.d/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # --- SPA ---
    location / {
        # security-headers.conf ahora vive en /etc/nginx/templates/ (para
        # que envsubst resuelva ${CSP_CONNECT_SRC_EXTRA}) — el entrypoint
        # oficial de nginx lo procesa y lo deja en /etc/nginx/conf.d/.
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }
}
